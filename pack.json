{
  "pack": "real-wopr-programs",
  "version": "1.0.0",
  "author": "Daniel Landi",
  "homepage": "https://realwopr.ai",
  "description": "The period-language programs behind realwopr.ai \u2014 WarGames' W.O.P.R. reconstructed in the languages of its era. Each program is a self-contained subprocess speaking a line protocol; the modern harness that hosts them is in emulator/.",
  "contract": "Each program: source at its folder top; harness/{manifest.json,build.sh,tests/}. Build -> harness/bin/<binary>. The binary reads one request frame on stdin and writes one response frame on stdout (see PACK.md).",
  "networks": {
    "pstn": {
      "kind": "dialup",
      "baud": 1200,
      "addressing": "phone",
      "public": true
    },
    "norad": {
      "kind": "leased",
      "baud": 9600,
      "addressing": "hostname",
      "public": false
    },
    "bus": {
      "kind": "local",
      "addressing": "name",
      "private": true
    }
  },
  "nodesComment": "A WAITING ROOM, not a second home for topology. A node that is a program declares itself inline, in its own harness/manifest.json. This section holds only nodes with no period source yet \u2014 WOPR, whose routing decisions still live in the modern harness. When wopr/ exists as a program, this entry moves into its manifest and this section shrinks. The topology validator warns about every entry here on purpose.",
  "nodes": {
    "wopr": {
      "title": "W.O.P.R.",
      "networks": {
        "pstn": {
          "address": "(311) 486-0623",
          "protocol": "SYSTEM/1"
        },
        "norad": {
          "address": "WOPR",
          "protocol": "SYSTEM/1"
        }
      },
      "mounts": [
        "games/*",
        "joshua"
      ],
      "peers": [
        "reference"
      ]
    }
  },
