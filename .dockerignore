# Build context for emulator/node/Dockerfile, whose context is the pack root.
# Without this the context carries ~425MB of node_modules and venvs.

.git
.github

# Language toolchains — reinstalled inside the image.
**/node_modules
**/.venv
**/__pycache__
**/*.egg-info
**/.pytest_cache

# Next.js output.
**/.next
**/out

# Program binaries: the 'programs' stage rebuilds every one from source, and
# host-built binaries are the wrong architecture anyway. Never ship them in.
**/harness/bin

# Packaged artifact.
dist
