# Build output — regenerated by each program's harness/build.sh.
**/harness/bin/
# Assembler/linker intermediates.
*.o
*.prg
# Packaged artifact.
dist/

# --- emulator/ (the modern harness) ---
# Language toolchains.
node_modules/
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# Next.js build output for the web surfaces. next-env.d.ts and the
# tsbuildinfo cache are regenerated by `next build` — Next's own template
# ignores them, and tracking them means builds dirty the tree.
.next/
out/
next-env.d.ts
*.tsbuildinfo
# Environments & secrets.
.env
.env.*
!.env.example
